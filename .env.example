# SideWeb Server Environment Variables

# Optional: Repository API key for authenticating upstream repository requests
# Automatically attached by the server as:
#   Authorization: Bearer <REPO_API_KEY>
#   X-API-Key: <REPO_API_KEY>
REPO_API_KEY=

# Optional: Repository upload endpoint for forwarding newer versions extracted from headsets
# Example: https://repo.example.com/api/upload
REPO_UPLOAD_URL=
